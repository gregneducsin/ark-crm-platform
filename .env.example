# ─────────────────────────────────────────────────────────────────────────────
# Ark Health Platform — Environment Variables Reference
#
# Copy to .env and fill in values for local development:
#   cp .env.example .env
#
# This file is loaded automatically in development via `--env-file=.env`
# (Node's built-in env-file loader — no dotenv dependency needed).
# Never commit .env to version control (it's already gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ────────────────────────────────────────────────────────
# PostgreSQL 16 connection string. No default — the app refuses to start without it.
DATABASE_URL=postgres://ark:localdev@localhost:5432/ark_health

# ── API server ───────────────────────────────────────────────────────────────
# TCP port the API server binds to. Default: 3001.
PORT=3001
# "development", "production", or "test". Default: development.
NODE_ENV=development
# Pino log level: error | warn | info | debug. Default: info.
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins (browser origins allowed to send
# credentialed requests to the API), e.g. https://app.example.com,https://staging.example.com
# No default — required in production. In development, defaults to the dashboard
# dev server's own origin (http://localhost:5173) if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Slack webhook URL (Incoming Webhook or Workflow Builder "From a webhook"
# trigger) that receives a { "message": "..." } POST body. Alerts on
# needs-attention conversations and SMS/email/webhook send failures. Optional
# — unset means no Slack alerts are sent, no error is raised.
SLACK_WEBHOOK_URL=

# Comma-separated admin email addresses seeded on first successful migration+seed run.
# Trimmed, lowercased, validated, and deduplicated automatically. Seeded users have
# no password set yet — the seed step prints a one-time invitation link to stdout
# (see packages/db/src/seed.ts) which is the only way to activate the account.
# If unset, no bootstrap admin users are created (a warning is logged, not an error).
BOOTSTRAP_ADMIN_EMAILS=

# Public base URL of the dashboard, used only to build human-shareable links
# (bootstrap-admin invitation links, password-reset links) printed to stdout.
# No email transport is wired up in this phase — these links are
# operator-visible only. Leave unset to get relative paths (fine for local
# development). e.g. https://app.example.com
WEB_PUBLIC_URL=

# ── AI assistant (dashboard "ask about the data" widget) ──────────────────────
# Anthropic API key (console.anthropic.com). No default — the assistant
# endpoint refuses requests without it, but the rest of the app still works.
ANTHROPIC_API_KEY=

# ── Abandoned-intake trigger links ─────────────────────────────────────────────
# Base URL this API is reachable at, used to build the shareable /go/:token
# link (e.g. https://api.example.com). BASK_QUESTIONNAIRE_URL is the plain
# universal Bask questionnaire URL; BASK_QUESTIONNAIRE_PROMO_URL is the
# $20-off variant, used when the Alexis conversation offered that discount.
INTAKE_LINK_BASE_URL=
BASK_QUESTIONNAIRE_URL=
BASK_QUESTIONNAIRE_PROMO_URL=

# ── Alexis/Sophie conversation loop (ai-guardrailed messaging) ────────────────────
# Reuses ANTHROPIC_API_KEY above. No separate key needed.

# ── Outbound SMS/iMessage provider ─────────────────────────────────────────────
# Which provider getSmsProvider() (lib/sms-provider.ts) returns. Currently
# only "iblusend" is implemented; leave unset to keep sending disabled
# (sends are logged-and-skipped, never thrown out of the dispatch pipeline).
SMS_PROVIDER=
# iBluSend API key (Developer → API Keys in their dashboard). Use an
# iblu_test_... key for a real integration test with zero risk of an actual
# send; swap to a live iblu_... key when ready.
IBLUSEND_API_KEY=
# Signing secret for iBluSend's inbound webhook (Developer → Outbound
# Webhooks, shown once you register this API's /api/webhooks/iblusend-message
# URL there). Verifies the X-iBluSend-Signature header — see
# createIbluSendWebhookAuth in middleware/webhookAuth.ts.
IBLUSEND_WEBHOOK_SECRET=

# ── Outbound/inbound email (Alexis/Sophie AI email + trigger notices) ────────────
# Which provider getEmailProvider() (lib/email-provider.ts) returns:
#   "gmail_api"        — Gmail API over HTTPS (port 443). Recommended — many
#                         hosts (Railway included) block outbound SMTP as an
#                         anti-spam measure, but HTTPS to Google's API isn't
#                         blocked the same way. Requires the GOOGLE_CLIENT_*/
#                         GOOGLE_REFRESH_TOKEN vars below, obtained once via
#                         the /auth/google connect flow (gmail-oauth.routes.ts,
#                         admin-only).
#   "google_workspace" — raw SMTP relay (smtp-relay.gmail.com). Requires "SMTP
#                         Authentication" enabled for the workspace (Admin
#                         console → Apps → Google Workspace → Gmail → Routing
#                         → SMTP relay service) and a mailbox app password.
#                         Kept working and available, but likely to hang/fail
#                         on a host that blocks outbound SMTP — try gmail_api
#                         first.
# Leave unset to keep email sending disabled (sends are logged-and-skipped,
# never thrown out of the dispatch pipeline — same fail-soft behavior as
# SMS_PROVIDER above).
EMAIL_PROVIDER=

# gmail_api vars — obtained via the one-time /auth/google connect flow.
# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET come from the OAuth 2.0 Client ID in
# Google Cloud Console (APIs & Services → Credentials); GOOGLE_REDIRECT_URI
# must exactly match an "Authorized redirect URI" registered on that same
# client (full path, e.g. https://<host>/auth/google/callback — NOT the bare
# origin, that's a different field); GOOGLE_REFRESH_TOKEN is minted by
# actually completing the consent flow (visit /auth/google while logged into
# the dashboard as admin) and copying the value the callback response shows
# — never paste this value anywhere outside Railway's own variable editor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
# Optional — the From address for gmail_api sends. Defaults to
# GOOGLE_WORKSPACE_SMTP_USER below (the same mailbox either provider sends
# as) when unset, so only set this if they should differ.
GOOGLE_GMAIL_FROM_EMAIL=

# Google Workspace mailbox used for outbound SMTP relay send (google_workspace
# provider), the gmail_api provider's default From address, AND inbound IMAP
# polling — the same mailbox throughout. The app password below is REQUIRED
# regardless of which EMAIL_PROVIDER is set (even gmail_api) — IMAP inbound
# polling always authenticates with a plain app password, never OAuth, so
# this is needed for inbound even when send goes over the Gmail API. Requires
# 2-Step Verification enabled on the account to mint one. Google displays it
# as 4 space-separated groups — paste it exactly as shown, spaces and all;
# whitespace is stripped automatically.
GOOGLE_WORKSPACE_SMTP_USER=
GOOGLE_WORKSPACE_SMTP_APP_PASSWORD=
# Optional — additional real mailboxes on the same Google Workspace to also
# poll for inbound routing (e.g. hello@ or a staff member's own address that
# customers sometimes reply to directly). Don't use this for an alias of the
# mailbox above — mail sent to an alias already lands in that same inbox and
# is picked up for free. Each mailbox needs its own 2-Step-Verification app
# password (Google account → Security → App passwords), same as above.
# Format: "user1@domain:apppassword1,user2@domain:apppassword2" — a space
# works fine instead of the colon too (e.g. "hello@domain ffax ibpx xqzz hwaa"),
# and commas separate multiple mailboxes.
#
# Whichever mailbox (primary or one of these) a customer's email actually
# arrives at is exactly which address Alexis/Sophie's reply sends from — a
# customer who wrote to hello@ keeps hearing back from hello@, not always the
# primary GOOGLE_WORKSPACE_SMTP_USER address. For this to work you also need
# the sending mailbox's Gmail "Send mail as" settings to include every other
# polled address as a verified alias (same-domain aliases verify instantly
# for a Workspace admin, no confirmation email needed) — otherwise Gmail
# silently falls back to sending from its own address instead of erroring.
EMAIL_INBOUND_EXTRA_MAILBOXES=
# Optional — comma-separated exact sender addresses to silently drop before
# they ever reach the unmatched-sender triage queue (never creates a thread,
# never gets classified). For known automated senders that happen to be
# addressed to the same polled mailbox as real customer inquiries — e.g. a
# practice-management platform's own operational alerts (new patient
# registered, prescription reminder, order notification), whether sent
# directly or via a same-Workspace domain alias. Case-insensitive exact
# match, not a domain/wildcard match. Example:
# "help@example-platform.ai,support@example-platform.ai"
EMAIL_INBOUND_IGNORED_SENDERS=
# Optional — SMTP port to connect on. Defaults to 587 (STARTTLS). Set to 465
# (implicit TLS) if your host blocks outbound 587, which some do for
# anti-spam reasons — 465 is the usual fallback Google's relay also accepts.
GOOGLE_WORKSPACE_SMTP_PORT=
# Optional — the From address on outbound mail via google_workspace (SMTP),
# if different from the authenticated mailbox above (only works if the
# workspace has "Allow users to send mail from a different address" enabled,
# or a Gmail "Send mail as" alias configured for GOOGLE_WORKSPACE_SMTP_USER).
# Defaults to GOOGLE_WORKSPACE_SMTP_USER when unset.
GOOGLE_WORKSPACE_FROM_EMAIL=
# Optional — override the display name Alexis/Sophie's emails show. Defaults to
# "Alexis at Ark Health" / "Sophie at Ark Health". Applies to both providers.
GOOGLE_WORKSPACE_ALEXIS_FROM_NAME=
GOOGLE_WORKSPACE_SOPHIE_FROM_NAME=
# Optional — display name for staff-facing system email (user invitations).
# Defaults to "Ark Health".
GOOGLE_WORKSPACE_SYSTEM_FROM_NAME=
# Signing secret for the stateless one-click-unsubscribe link every automated
# email carries (see lib/email/unsubscribe.ts) — generate a new random value
# per environment, do not reuse across dev/staging/prod.
EMAIL_UNSUBSCRIBE_SECRET=
# Physical postal address shown in every automated email's footer (CAN-SPAM
# requires one). Falls back to a bare "Ark Health" placeholder if unset —
# set a real address before sending real email.
ARK_PHYSICAL_ADDRESS=

# ── Webhook secrets (shared-secret header, constant-time compared) ────────────
# Generate a new random value per environment — do not reuse across dev/staging/prod.
GHL_WEBHOOK_SECRET=
ORDER_WEBHOOK_SECRET=
QUESTIONNAIRE_WEBHOOK_SECRET=
FAILED_PAYMENT_WEBHOOK_SECRET=
PAYMENT_SUCCEEDED_WEBHOOK_SECRET=
REFUND_WEBHOOK_SECRET=
PRESCRIPTION_WRITTEN_WEBHOOK_SECRET=
ORDER_SHIPPED_WEBHOOK_SECRET=

# ── Dashboard (Vite dev server only — production build has no runtime env vars) ─
# Port the Vite dev server binds to. Default: 5173.
WEB_PORT=5173
# Base path the dashboard is mounted at. Default: "/". Only change if serving
# the SPA from a subpath (e.g. "/dashboard").
BASE_PATH=/
# Dev-only: which local port the dashboard's dev-server proxy forwards /api/*
# requests to. Should match PORT above. Default: 3001.
API_PROXY_PORT=3001

# ── Testing only — do not set in development or production ────────────────────
# Isolates a test run to a named Postgres schema (e.g. _ark_test_ci). Set
# automatically by the test harness; never set this by hand.
POSTGRES_SCHEMA=
